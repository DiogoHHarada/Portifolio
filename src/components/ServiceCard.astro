---
import Icon from '@/components/Icon.astro';
import type { Servico } from '@/data/services';

interface Props {
  servico: Servico;
  nivel?: 'h2' | 'h3';
  /** Exibe a lista de entregáveis (página /servicos). */
  detalhado?: boolean;
}

const { servico, nivel = 'h3', detalhado = false } = Astro.props;
const Titulo = nivel;
---

<article
  class="flex h-full flex-col rounded-[var(--radius-card)] border border-border bg-surface p-6"
  id={detalhado ? servico.id : undefined}
>
  <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-surface-2 text-accent">
    <Icon name={servico.icone} size={24} />
  </span>
  <Titulo class="mt-5 text-xl font-semibold">{servico.titulo}</Titulo>
  <p class="mt-2 text-muted">{servico.resumo}</p>
  {detalhado && (
    <>
      <p class="mt-5 text-sm font-semibold text-text">O que normalmente inclui</p>
      <ul class="mt-3 space-y-2">
        {servico.entregaveis.map((item) => (
          <li class="flex gap-2 text-[0.95rem] text-muted">
            <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</article>
