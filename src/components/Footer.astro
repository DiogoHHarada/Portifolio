---
import Icon from '@/components/Icon.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { contato, navegacao, site, whatsappUrl } from '@/data/site';

const ano = new Date().getFullYear();
const direitos = `© ${ano} ${site.pessoa} · ${site.marca}`;
const classeLink =
  'inline-flex items-center gap-2 py-1.5 text-muted transition-colors hover:text-text';
---

<footer class="border-t border-border bg-bg">
  <div class="container-site grid gap-12 py-16 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="font-serif text-4xl leading-none">{site.marca}</p>
      <p class="mt-4 max-w-sm text-muted">
        Portfólio e serviços de {site.pessoa}, desenvolvedor web. Sites institucionais, lojas
        virtuais e landing pages.
      </p>
      <SocialLinks class="mt-6" />
    </div>

    <nav id="navegacao-rodape" aria-label="Rodapé" tabindex="-1">
      <h2 class="rotulo">Navegação</h2>
      <ul class="mt-5 space-y-0.5">
        {navegacao.map((item) => (
          <li>
            <a href={item.href} class={classeLink}>
              {item.rotulo}
            </a>
          </li>
        ))}
        <li>
          <a
            href={site.curriculo.href}
            download={site.curriculo.nomeArquivo}
            class={classeLink}
            data-evento="curriculo_download_click"
            data-posicao="rodape"
          >
            Currículo <span class="meta-mono">({site.curriculo.tamanho})</span>
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="rotulo">Contato</h2>
      <ul class="mt-5 space-y-0.5">
        <li>
          <a
            href={whatsappUrl(contato.mensagemOrcamento)}
            target="_blank"
            rel="noopener noreferrer"
            class={classeLink}
            data-evento="whatsapp_click"
            data-posicao="rodape"
          >
            <Icon name="whatsapp" size={18} />
            WhatsApp <span class="sr-only">(abre em nova aba)</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${contato.email}`} class={`${classeLink} break-all`}>
            <Icon name="email" size={18} />
            {contato.email}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="container-site meta-mono py-6">{direitos}</p>
  </div>
</footer>
