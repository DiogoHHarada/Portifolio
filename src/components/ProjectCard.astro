---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';
import Ilha from '@/components/Ilha.astro';
import { normalizarTecnologia } from '@/lib/projetos';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  /** Nível do título conforme a hierarquia da página. */
  nivel?: 'h2' | 'h3';
  /** true para imagens fora da primeira dobra (padrão). */
  lazy?: boolean;
  /** Posição na lista (começa em 1), exibida como índice editorial. */
  indice: number;
}

const { projeto, nivel = 'h3', lazy = true, indice } = Astro.props;
const { titulo, resumo, capa, capaAlt, tecnologias, ano, contexto } = projeto.data;
const Titulo = nivel;
const filtro = tecnologias.map(normalizarTecnologia).join('|');
const numero = String(indice).padStart(2, '0');
// Alterna o lado da imagem em telas largas para dar ritmo à lista.
const invertido = indice % 2 === 0;
---

<article
  class="group relative grid gap-6 border-t has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-accent border-border py-8 sm:py-10 lg:grid-cols-12 lg:items-center lg:gap-12"
  data-card-projeto
  data-tecnologias={filtro}
>
  <div
    data-capa
    class:list={[
      'relative overflow-hidden rounded-md border border-border bg-surface lg:col-span-7',
      invertido && 'lg:order-2',
    ]}
  >
    <Image
      src={capa}
      alt={capaAlt}
      widths={[480, 640, 800, 1000]}
      sizes="(min-width: 1280px) 640px, (min-width: 1024px) 53vw, calc(100vw - 2.5rem)"
      loading={lazy ? 'lazy' : 'eager'}
      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.025]"
    />
    <Ilha
      nome="capa-pixel"
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      props={{ pixelSize: 22, duration: 1.3 }}
    />
  </div>
  <div class="flex flex-col lg:col-span-5">
    <p class="flex items-center gap-3">
      <span class="indice">{numero}</span>
      <span class="h-px w-8 bg-border-strong" aria-hidden="true"></span>
      <span class="meta-mono uppercase">
        {contexto} · {ano}
      </span>
    </p>
    <Titulo class="mt-4 font-serif text-4xl leading-[1.02] tracking-tight sm:text-5xl">
      <a
        href={`/projetos/${projeto.id}`}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >
        {titulo}
      </a>
    </Titulo>
    <p class="mt-4 text-muted">{resumo}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologias">
      {tecnologias.map((t) => (
        <li class="chip">{t}</li>
      ))}
    </ul>
    <p
      class="mt-7 inline-flex items-center gap-2 font-medium text-text underline decoration-accent underline-offset-[0.35em] group-hover:decoration-2"
      aria-hidden="true"
    >
      Ver estudo de caso
      <Icon name="seta-direita" size={16} class="transition-transform group-hover:translate-x-1" />
    </p>
  </div>
</article>
