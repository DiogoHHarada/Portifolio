---
/**
 * Filtro por tecnologia (RF-05). A listagem completa já está no HTML; sem JavaScript
 * (@media scripting: none → .js-only) o filtro fica oculto e todos os projetos continuam
 * visíveis. Com JavaScript ele já aparece no primeiro paint, sem deslocar o layout (CLS).
 */
interface Props {
  opcoes: { valor: string; rotulo: string; total: number }[];
  total: number;
  /** id do contêiner com os cards ([data-card-projeto]) */
  alvo: string;
}

const { opcoes, total, alvo } = Astro.props;
const classeBotao =
  'inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-border px-4 py-2 text-sm font-medium text-text transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent';
---

<div data-filtro data-alvo={alvo} class="js-only">
  <h2 id="titulo-filtro" class="text-sm font-semibold tracking-wider text-muted uppercase">
    Filtrar por tecnologia
  </h2>
  <div role="group" aria-labelledby="titulo-filtro" class="mt-3 flex flex-wrap gap-2">
    <button type="button" class={classeBotao} data-valor="" aria-pressed="true">
      Todas <span class="text-xs opacity-80">({total})</span>
    </button>
    {opcoes.map((opcao) => (
      <button
        type="button"
        class={classeBotao}
        data-valor={opcao.valor}
        data-rotulo={opcao.rotulo}
        aria-pressed="false"
      >
        {opcao.rotulo} <span class="text-xs opacity-80">({opcao.total})</span>
      </button>
    ))}
  </div>
  <p role="status" class="mt-4 text-sm text-muted" data-filtro-status></p>
</div>

<script>
  for (const filtro of document.querySelectorAll<HTMLElement>('[data-filtro]')) {
    const alvoId = filtro.dataset['alvo'];
    const lista = alvoId ? document.getElementById(alvoId) : null;
    const status = filtro.querySelector<HTMLElement>('[data-filtro-status]');
    const vazio = document.querySelector<HTMLElement>('[data-filtro-vazio]');
    if (!lista) continue;

    const cards = [...lista.querySelectorAll<HTMLElement>('[data-card-projeto]')];
    const botoes = [...filtro.querySelectorAll<HTMLButtonElement>('button[data-valor]')];

    const aplicar = (valor: string, rotulo: string) => {
      let visiveis = 0;
      for (const card of cards) {
        const tecnologias = (card.dataset['tecnologias'] ?? '').split('|');
        const mostrar = valor === '' || tecnologias.includes(valor);
        const item = card.closest('li') ?? card;
        item.hidden = !mostrar;
        if (mostrar) visiveis++;
      }
      for (const botao of botoes) {
        botao.setAttribute('aria-pressed', String(botao.dataset['valor'] === valor));
      }
      if (vazio) vazio.hidden = visiveis !== 0;
      if (status) {
        const plural = visiveis === 1 ? 'projeto encontrado' : 'projetos encontrados';
        status.textContent =
          valor === '' ? `${visiveis} ${plural}.` : `${visiveis} ${plural} com ${rotulo}.`;
      }
    };

    for (const botao of botoes) {
      botao.addEventListener('click', () => {
        aplicar(botao.dataset['valor'] ?? '', botao.dataset['rotulo'] ?? '');
      });
    }
  }
</script>
