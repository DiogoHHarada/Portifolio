---
import Icon from '@/components/Icon.astro';
import { contato, whatsappUrl } from '@/data/site';

interface Props {
  titulo?: string;
  texto?: string;
  /** Posição para métricas (sem dados pessoais). */
  posicao: string;
}

const {
  titulo = 'Tem um projeto em mente?',
  texto = 'Conte o que você precisa pelo WhatsApp. A conversa é direta comigo e serve para entender o objetivo antes de qualquer proposta.',
  posicao,
} = Astro.props;
---

<section aria-labelledby={`cta-${posicao}`} class="mt-28 bg-accent text-on-accent sm:mt-36">
  <div class="container-site grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-end">
    <div>
      <p class="rotulo text-on-accent/70 before:bg-on-accent">Contato</p>
      <h2
        id={`cta-${posicao}`}
        class="titulo-display mt-5 text-[clamp(2.75rem,1.5rem+5.5vw,5.5rem)]"
      >
        {titulo}
      </h2>
    </div>
    <div>
      <p class="max-w-md text-lg text-on-accent/80">{texto}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappUrl(contato.mensagemOrcamento)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-escuro"
          data-evento="whatsapp_click"
          data-posicao={posicao}
        >
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp <span class="sr-only">(abre em nova aba)</span>
        </a>
        <a href="/contato" class="btn btn-contorno-escuro">
          Outras formas de contato
        </a>
      </div>
    </div>
  </div>
</section>
