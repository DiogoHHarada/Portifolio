---
import { Image } from 'astro:assets';
import logo from '@/assets/institucional/logo-harada-devsystems.png';
import MobileMenu from '@/components/MobileMenu.astro';
import Icon from '@/components/Icon.astro';
import { navegacao } from '@/data/site';

const atual = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';

function ativo(href: string): boolean {
  return href === '/' ? atual === '/' : atual === href || atual.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur-md">
  <!-- Ordem do DOM: logo → botão do menu → navegação. Assim, com o menu aberto no celular,
       o próximo Tab a partir do botão entra direto nos links. -->
  <div class="container-site relative flex h-16 items-center justify-between gap-3 lg:h-[4.5rem]">
    <a href="/" class="shrink-0 rounded-md" aria-label="Harada DevSystems — página inicial">
      <Image
        src={logo}
        alt=""
        width={123}
        height={44}
        densities={[1, 2]}
        loading="eager"
        class="h-9 w-auto lg:h-10"
      />
    </a>

    <MobileMenu controla="menu-principal" />

    <nav
      id="menu-principal"
      aria-label="Navegação principal"
      data-aberto="false"
      class="max-lg:absolute max-lg:inset-x-0 max-lg:top-full max-lg:hidden max-lg:border-b max-lg:border-border max-lg:bg-bg max-lg:data-[aberto=true]:block"
    >
      <ul class="container-site flex flex-col py-2 lg:w-auto lg:flex-row lg:items-center lg:gap-1 lg:p-0">
        {navegacao.map((item, i) => (
          <li class="max-lg:border-b max-lg:border-border">
            <a
              href={item.href}
              aria-current={ativo(item.href) ? 'page' : undefined}
              class="group flex items-center gap-4 rounded-md px-1 py-4 text-muted transition-colors hover:text-text aria-[current=page]:text-text lg:gap-2 lg:px-3 lg:py-2 lg:text-[0.9rem]"
            >
              <span class="indice w-6 lg:hidden" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span
                class="hidden size-1.5 bg-transparent transition-colors group-aria-[current=page]:bg-accent lg:block"
                aria-hidden="true"
              ></span>
              <span class="font-serif text-3xl leading-none lg:font-sans lg:text-[0.9rem]">
                {item.rotulo}
              </span>
            </a>
          </li>
        ))}
        <li class="py-5 lg:py-0 lg:pl-4">
          <a
            href="/contato"
            class="btn btn-primary w-full lg:min-h-10 lg:w-auto lg:px-4 lg:py-2 lg:text-sm"
            data-evento="cta_orcamento_click"
            data-posicao="cabecalho"
          >
            Pedir orçamento
            <Icon name="seta-direita" size={16} class="icone-seta" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
