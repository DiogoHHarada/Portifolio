---
import Icon from '@/components/Icon.astro';
import { redesVisiveis, site } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2', className]}>
  {redesVisiveis.map((rede) => (
    <li>
      <a
        href={rede.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${rede.nome} de ${site.pessoa} (abre em nova aba)`}
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-border-strong text-text transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name={rede.icone} size={20} />
      </a>
    </li>
  ))}
</ul>
