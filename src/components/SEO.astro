---
import { VERCEL_ENV } from 'astro:env/server';
import { site } from '@/data/site';

interface Props {
  /** Título específico da página (sem o sufixo da marca). Omitir apenas na home. */
  title?: string;
  description: string;
  /** Caminho de imagem social absoluto no site (ex.: /og-default.png) ou URL https. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = site.ogImagem.src,
  imageAlt = site.ogImagem.alt,
  imageWidth = site.ogImagem.largura,
  imageHeight = site.ogImagem.altura,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

if (!Astro.site) {
  throw new Error('Defina `site` em astro.config.mjs para gerar canonical e Open Graph.');
}

const tituloCompleto = title
  ? `${title} | ${site.pessoa}`
  : `${site.pessoa} | ${site.cargo} — ${site.marca}`;

// Canonical sempre aponta para o domínio de produção configurado, sem barra final.
const caminho = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(caminho, Astro.site).href;
const imagemAbsoluta = new URL(image, Astro.site).href;

// Previews da Vercel não devem ser indexados (RNF-14); produção segue indexável.
const bloquearIndexacao = noindex || VERCEL_ENV === 'preview';

const jsonLdSeguro = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<title>{tituloCompleto}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{bloquearIndexacao && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.marca} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagemAbsoluta} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imagemAbsoluta} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLdSeguro && <script is:inline type="application/ld+json" set:html={jsonLdSeguro} />}
