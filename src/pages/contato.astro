---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { contato, redesVisiveis, site, whatsappUrl } from '@/data/site';

const classeCanal =
  'group flex items-center justify-between gap-4 py-5 text-lg text-text transition-colors hover:text-accent';
---

<BaseLayout
  title="Contato"
  description="Fale com Diogo Harada pelo WhatsApp para pedir um orçamento de site, loja virtual ou landing page. Também por e-mail, LinkedIn e GitHub."
>
  <section class="container-site pt-12 pb-8 sm:pt-20" aria-labelledby="titulo-pagina">
    <p class="rotulo">Contato</p>
    <h1 id="titulo-pagina" class="titulo-pagina mt-6">
      Vamos <em class="destaque-serif">conversar</em>
    </h1>
    <p class="lead mt-6">
      Para pedir um orçamento, o caminho mais rápido é o WhatsApp: conte que tipo de site você
      precisa e o objetivo do projeto. Recrutadores também podem usar o e-mail ou o LinkedIn.
    </p>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="bg-accent p-8 text-on-accent sm:p-12">
          <h2 class="flex items-center gap-3 font-serif text-5xl leading-none tracking-tight">
            <Icon name="whatsapp" size={36} /> WhatsApp
          </h2>
          <p class="mt-6 max-w-md text-on-accent/80">
            O link abre uma conversa com uma mensagem inicial pronta, que você pode editar antes de
            enviar.
          </p>
          <p class="mt-3 font-mono text-sm">
            Número: <span class="font-medium">{contato.whatsappExibicao}</span>
          </p>
          <a
            href={whatsappUrl(contato.mensagemOrcamento)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-escuro mt-8 w-full sm:w-auto"
            data-evento="whatsapp_click"
            data-posicao="contato"
          >
            <Icon name="whatsapp" size={20} />
            Falar no WhatsApp <span class="sr-only">(abre em nova aba)</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <h2 class="rotulo">Outros canais</h2>
        <ul class="linhas mt-5">
          <li>
            <a href={`mailto:${contato.email}`} class={`${classeCanal} break-all`}>
              <span class="flex items-center gap-3">
                <Icon name="email" size={22} class="shrink-0 text-accent" />
                <span>
                  <span class="sr-only">E-mail: </span>
                  {contato.email}
                </span>
              </span>
              <Icon name="seta-direita" size={16} class="shrink-0 text-muted" />
            </a>
          </li>
          {redesVisiveis.map((rede) => (
            <li>
              <a href={rede.url} target="_blank" rel="noopener noreferrer" class={classeCanal}>
                <span class="flex items-center gap-3">
                  <Icon name={rede.icone} size={22} class="shrink-0 text-accent" />
                  <span>
                    {rede.nome} <span class="sr-only">de {site.pessoa} (abre em nova aba)</span>
                  </span>
                </span>
                <Icon name="externo" size={16} class="shrink-0 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="h-24" aria-hidden="true"></div>
</BaseLayout>
