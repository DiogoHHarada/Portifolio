---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { contato, redesVisiveis, site, whatsappUrl } from '@/data/site';
---

<BaseLayout
  title="Contato"
  description="Fale com Diogo Harada pelo WhatsApp para pedir um orçamento de site, loja virtual ou landing page. Também por e-mail, LinkedIn e GitHub."
>
  <section class="container-site pt-10 sm:pt-16" aria-labelledby="titulo-pagina">
    <p class="eyebrow">Contato</p>
    <h1 id="titulo-pagina" class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
      Vamos conversar
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Para pedir um orçamento, o caminho mais rápido é o WhatsApp: conte que tipo de site você
      precisa e o objetivo do projeto. Recrutadores também podem usar o e-mail ou o LinkedIn.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <div class="rounded-[var(--radius-card)] border border-accent/40 bg-surface p-6 sm:p-8">
        <h2 class="flex items-center gap-3 text-2xl font-semibold">
          <Icon name="whatsapp" size={28} class="text-accent" /> WhatsApp
        </h2>
        <p class="mt-3 text-muted">
          O link abre uma conversa com uma mensagem inicial pronta, que você pode editar antes de
          enviar.
        </p>
        <p class="mt-2 text-muted">
          Número: <span class="font-medium text-text">{contato.whatsappExibicao}</span>
        </p>
        <a
          href={whatsappUrl(contato.mensagemOrcamento)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary mt-6 w-full sm:w-auto"
          data-evento="whatsapp_click"
          data-posicao="contato"
        >
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp <span class="sr-only">(abre em nova aba)</span>
        </a>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Outros canais</h2>
        <ul class="mt-5 space-y-3">
          <li>
            <a
              href={`mailto:${contato.email}`}
              class="flex items-center gap-3 rounded-lg py-2 break-all text-text hover:text-accent"
            >
              <Icon name="email" size={22} class="shrink-0 text-accent" />
              <span>
                <span class="sr-only">E-mail: </span>
                {contato.email}
              </span>
            </a>
          </li>
          {redesVisiveis.map((rede) => (
            <li>
              <a
                href={rede.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 rounded-lg py-2 text-text hover:text-accent"
              >
                <Icon name={rede.icone} size={22} class="shrink-0 text-accent" />
                <span>
                  {rede.nome} <span class="sr-only">de {site.pessoa} (abre em nova aba)</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
