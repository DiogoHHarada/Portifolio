---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon from '@/components/Icon.astro';
import { listarProjetos, type Projeto } from '@/lib/projetos';

export async function getStaticPaths() {
  const projetos = await listarProjetos();
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const { titulo, resumo, capa, capaAlt, tecnologias, papel, contexto, ano, links, galeria } =
  projeto.data;
const { Content } = await render(projeto);

// Imagem social específica do case: capa recortada em 1200x630.
const og = await getImage({ src: capa, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<BaseLayout
  title={titulo}
  description={resumo}
  image={og.src}
  imageAlt={capaAlt}
  imageWidth={1200}
  imageHeight={630}
  type="article"
>
  <article class="container-site pt-10 sm:pt-16">
    <nav aria-label="Trilha de navegação" class="meta-mono">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-text">
            Início
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/projetos" class="hover:text-text">
            Projetos
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <span aria-current="page" class="text-text">
            {titulo.split(' — ')[0]}
          </span>
        </li>
      </ol>
    </nav>

    <header class="mt-8 max-w-5xl">
      <p class="rotulo">{contexto}</p>
      <h1 class="titulo-pagina mt-6 text-[clamp(2.4rem,1.4rem+4.4vw,4.5rem)]">{titulo}</h1>
      <p class="lead mt-6">{resumo}</p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <aside class="lg:col-span-4" aria-label="Ficha do projeto">
        <div class="lg:sticky lg:top-28">
          <dl class="border-b border-border">
            <div class="border-t border-border py-4">
              <dt class="meta-mono uppercase">Minha participação</dt>
              <dd class="mt-1.5">{papel}</dd>
            </div>
            <div class="border-t border-border py-4">
              <dt class="meta-mono uppercase">Ano</dt>
              <dd class="mt-1.5">{ano}</dd>
            </div>
            <div class="border-t border-border py-4">
              <dt class="meta-mono uppercase">Tecnologias</dt>
              <dd class="mt-3">
                <ul class="flex flex-wrap gap-2">
                  {tecnologias.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>

          {(links.demo || links.github) && (
            <div class="mt-6 flex flex-col gap-3">
              {links.demo && (
                <a
                  href={links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                  data-evento="projeto_link_externo_click"
                  data-slug={projeto.id}
                  data-tipo="demo"
                >
                  <Icon name="externo" size={18} />
                  Ver demo <span class="sr-only">de {titulo} (abre em nova aba)</span>
                </a>
              )}
              {links.github && (
                <a
                  href={links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={['btn', links.demo ? 'btn-secondary' : 'btn-primary']}
                  data-evento="projeto_link_externo_click"
                  data-slug={projeto.id}
                  data-tipo="github"
                >
                  <Icon name="github" size={18} />
                  Código-fonte <span class="sr-only">de {titulo} no GitHub (abre em nova aba)</span>
                </a>
              )}
            </div>
          )}
        </div>
      </aside>

      <div class="lg:col-span-8">
        <Image
          src={capa}
          alt={capaAlt}
          widths={[640, 960, 1200]}
          sizes="(min-width: 1024px) 720px, calc(100vw - 2.5rem)"
          priority
          class="aspect-[16/10] w-full rounded-md border border-border object-cover object-top"
        />

        <div class="prosa mt-10">
          <Content />
        </div>

        {galeria.length > 0 && (
          <section class="mt-16" aria-labelledby="titulo-galeria">
            <h2 id="titulo-galeria" class="titulo-secao">
              Imagens do projeto
            </h2>
            <ul class="mt-8 grid gap-8">
              {galeria.map((item) => (
                <li>
                  <figure>
                    <Image
                      src={item.imagem}
                      alt={item.alt}
                      widths={[480, 720, 1080]}
                      sizes="(min-width: 1024px) 720px, calc(100vw - 2.5rem)"
                      class="h-auto w-full rounded-md border border-border"
                    />
                    {item.legenda && <figcaption class="meta-mono mt-3">{item.legenda}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    <p class="mt-16">
      <a href="/projetos" class="link-seta">
        <Icon name="seta-esquerda" size={16} /> Voltar para projetos
      </a>
    </p>
  </article>

  <ContactCTA posicao={`projeto-${projeto.id}`} />
</BaseLayout>
