---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon from '@/components/Icon.astro';
import { listarProjetos, type Projeto } from '@/lib/projetos';

export async function getStaticPaths() {
  const projetos = await listarProjetos();
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const { titulo, resumo, capa, capaAlt, tecnologias, papel, contexto, ano, links, galeria } =
  projeto.data;
const { Content } = await render(projeto);

// Imagem social específica do case: capa recortada em 1200x630.
const og = await getImage({ src: capa, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<BaseLayout
  title={titulo}
  description={resumo}
  image={og.src}
  imageAlt={capaAlt}
  imageWidth={1200}
  imageHeight={630}
  type="article"
>
  <article class="container-site pt-8 sm:pt-12">
    <nav aria-label="Trilha de navegação" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-accent">
            Início
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/projetos" class="hover:text-accent">
            Projetos
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <span aria-current="page" class="text-text">
            {titulo.split(' — ')[0]}
          </span>
        </li>
      </ol>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">{contexto}</p>
      <h1 class="mt-2 text-3xl leading-tight font-bold tracking-tight sm:text-5xl">{titulo}</h1>
      <p class="mt-4 text-lg text-muted">{resumo}</p>
    </header>

    <dl class="mt-8 grid gap-6 rounded-[var(--radius-card)] border border-border bg-surface p-6 sm:grid-cols-3">
      <div>
        <dt class="text-sm text-muted">Minha participação</dt>
        <dd class="mt-1 font-medium">{papel}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Ano</dt>
        <dd class="mt-1 font-medium">{ano}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted">Tecnologias</dt>
        <dd class="mt-2">
          <ul class="flex flex-wrap gap-2">
            {tecnologias.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>

    {(links.demo || links.github) && (
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        {links.demo && (
          <a
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            data-evento="projeto_link_externo_click"
            data-slug={projeto.id}
            data-tipo="demo"
          >
            <Icon name="externo" size={18} />
            Ver demo <span class="sr-only">de {titulo} (abre em nova aba)</span>
          </a>
        )}
        {links.github && (
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['btn', links.demo ? 'btn-secondary' : 'btn-primary']}
            data-evento="projeto_link_externo_click"
            data-slug={projeto.id}
            data-tipo="github"
          >
            <Icon name="github" size={18} />
            Código-fonte <span class="sr-only">de {titulo} no GitHub (abre em nova aba)</span>
          </a>
        )}
      </div>
    )}

    <Image
      src={capa}
      alt={capaAlt}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1152px) 1104px, calc(100vw - 2rem)"
      priority
      class="mt-10 aspect-[16/10] w-full rounded-[var(--radius-card)] border border-border object-cover object-top"
    />

    <div class="prosa mt-6">
      <Content />
    </div>

    {galeria.length > 0 && (
      <section class="mt-14" aria-labelledby="titulo-galeria">
        <h2 id="titulo-galeria" class="text-2xl font-bold">
          Imagens do projeto
        </h2>
        <ul class="mt-6 grid gap-6 md:grid-cols-2">
          {galeria.map((item) => (
            <li>
              <figure>
                <Image
                  src={item.imagem}
                  alt={item.alt}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="h-auto w-full rounded-xl border border-border"
                />
                {item.legenda && (
                  <figcaption class="mt-2 text-sm text-muted">{item.legenda}</figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-14">
      <a href="/projetos" class="link-texto inline-flex items-center gap-2 font-semibold">
        <Icon name="seta-esquerda" size={16} /> Voltar para projetos
      </a>
    </p>
  </article>

  <ContactCTA posicao={`projeto-${projeto.id}`} />
</BaseLayout>
