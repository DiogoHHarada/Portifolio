---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProjectFilters from '@/components/ProjectFilters.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { listarProjetos, opcoesDeTecnologia } from '@/lib/projetos';

const projetos = await listarProjetos();
const opcoes = opcoesDeTecnologia(projetos);
---

<BaseLayout
  title="Projetos"
  description="Projetos de Diogo Harada com código-fonte aberto: plataforma de monitoramento meteorológico em Laravel, loja virtual em PHP e PostgreSQL e site para cafeteria. Filtre por tecnologia."
>
  <section class="container-site pt-12 sm:pt-20" aria-labelledby="titulo-pagina">
    <p class="rotulo">Portfólio</p>
    <h1 id="titulo-pagina" class="titulo-pagina mt-6">
      Projetos com <em class="destaque-serif">código aberto</em>
    </h1>
    <p class="lead mt-6">
      Trabalhos acadêmicos e de estudo com repositório público. Cada um tem uma página com o
      problema, a solução, minha participação e as tecnologias usadas.
    </p>

    <div class="mt-12">
      <ProjectFilters opcoes={opcoes} total={projetos.length} alvo="lista-projetos" />
    </div>

    <ul id="lista-projetos" class="mt-8 border-b border-border">
      {projetos.map((projeto, i) => (
        <li>
          <ProjectCard projeto={projeto} nivel="h2" lazy={i > 1} indice={i + 1} />
        </li>
      ))}
    </ul>
    <p class="mt-8 border border-border bg-surface p-5 text-muted" data-filtro-vazio hidden>
      Nenhum projeto encontrado para este filtro. Selecione “Todas” para ver a lista completa.
    </p>
  </section>

  <ContactCTA posicao="projetos" />
</BaseLayout>
