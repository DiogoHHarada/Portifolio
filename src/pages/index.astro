---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon from '@/components/Icon.astro';
import retrato from '@/assets/institucional/diogo-harada-retrato.png';
import { listarDestaques } from '@/lib/projetos';
import { servicos } from '@/data/services';
import { redesVisiveis, site } from '@/data/site';
import { competencias } from '@/data/perfil';

const destaques = await listarDestaques();
if (destaques.length < 3) {
  console.warn(
    `[home] Apenas ${destaques.length} projeto(s) em destaque. RF-04 exige 3 cases reais (ver PENDENCIAS.md).`,
  );
}

const pessoaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.pessoa,
  jobTitle: site.cargo,
  url: Astro.site?.href,
  sameAs: redesVisiveis.map((r) => r.url),
  knowsAbout: competencias.flatMap((c) => c.itens),
};
---

<BaseLayout description={site.descricaoPadrao} jsonLd={pessoaJsonLd} type="profile">
  <!-- HERO: proposta + duas jornadas (clientes e recrutadores) -->
  <section class="container-site pt-10 pb-6 sm:pt-16 lg:pt-20" aria-labelledby="titulo-hero">
    <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_0.75fr]">
      <div>
        <p class="eyebrow">
          {site.pessoa} · {site.marca}
        </p>
        <h1
          id="titulo-hero"
          class="mt-3 text-[2rem] leading-[1.15] font-bold tracking-tight sm:text-5xl lg:text-[3.25rem]"
        >
          Desenvolvimento web com foco em velocidade e <span class="text-accent">clareza</span>.
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-muted">
          Sou {site.pessoa}, técnico em Informática pelo CTI-UNESP e estudante de Análise e
          Desenvolvimento de Sistemas no IFSP Caraguatatuba. Crio sites institucionais, lojas
          virtuais e landing pages. Conheça meus projetos ou peça um orçamento.
        </p>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="Escolha seu caminho">
          <li class="flex flex-col rounded-[var(--radius-card)] border border-border bg-surface p-5">
            <p class="flex items-center gap-2 font-semibold">
              <Icon name="conversa" size={20} class="text-accent" />
              Precisa de um site?
            </p>
            <p class="mt-1 text-sm text-muted">Conte sua ideia e receba uma proposta.</p>
            <a
              href="/contato"
              class="btn btn-primary mt-4"
              data-evento="cta_orcamento_click"
              data-posicao="hero"
            >
              Pedir orçamento
            </a>
          </li>
          <li class="flex flex-col rounded-[var(--radius-card)] border border-border bg-surface p-5">
            <p class="flex items-center gap-2 font-semibold">
              <Icon name="maleta" size={20} class="text-accent" />
              Recrutador ou equipe técnica?
            </p>
            <p class="mt-1 text-sm text-muted">Veja cases com código-fonte, stack e trajetória.</p>
            <a href="/projetos" class="btn btn-secondary mt-4">
              Ver projetos
            </a>
          </li>
        </ul>
      </div>

      <div class="mx-auto w-56 sm:w-72 lg:w-full lg:max-w-[22rem]">
        <Image
          src={retrato}
          alt="Diogo Harada, de óculos e camisa polo preta, com os braços cruzados sobre um hexágono verde."
          widths={[224, 288, 353]}
          sizes="(min-width: 1024px) 353px, (min-width: 640px) 288px, 224px"
          priority
          class="h-auto w-full"
        />
      </div>
    </div>
  </section>

  <!-- PROJETOS EM DESTAQUE -->
  <section class="container-site mt-20" aria-labelledby="titulo-projetos">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Portfólio</p>
        <h2 id="titulo-projetos" class="titulo-secao mt-2">
          Projetos em destaque
        </h2>
      </div>
      <a href="/projetos" class="link-texto inline-flex items-center gap-2 font-semibold">
        Todos os projetos <Icon name="seta-direita" size={16} />
      </a>
    </div>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destaques.map((projeto) => (
        <li>
          <ProjectCard projeto={projeto} nivel="h3" />
        </li>
      ))}
    </ul>
  </section>

  <!-- SERVIÇOS -->
  <section class="container-site mt-24" aria-labelledby="titulo-servicos">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Serviços</p>
        <h2 id="titulo-servicos" class="titulo-secao mt-2">
          O que posso fazer pelo seu negócio
        </h2>
      </div>
      <a href="/servicos" class="link-texto inline-flex items-center gap-2 font-semibold">
        Serviços e processo <Icon name="seta-direita" size={16} />
      </a>
    </div>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {servicos.map((servico) => (
        <li>
          <ServiceCard servico={servico} nivel="h3" />
        </li>
      ))}
    </ul>
  </section>

  <!-- TRAJETÓRIA (jornada do recrutador) -->
  <section class="container-site mt-24" aria-labelledby="titulo-trajetoria">
    <div class="grid gap-8 rounded-[var(--radius-card)] border border-border bg-surface p-6 sm:p-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Para recrutadores</p>
        <h2 id="titulo-trajetoria" class="titulo-secao mt-2">
          Formação técnica e código aberto
        </h2>
        <ul class="mt-6 space-y-4">
          <li>
            <p class="font-semibold">Técnico em Informática — CTI-UNESP, Bauru/SP</p>
            <p class="text-sm text-muted">2022–2024 · concluído · TCC: AtmoVision</p>
          </li>
          <li>
            <p class="font-semibold">Análise e Desenvolvimento de Sistemas — IFSP Caraguatatuba</p>
            <p class="text-sm text-muted">2025–2027 · em andamento</p>
          </li>
          <li>
            <p class="font-semibold">Estágio — Prefeitura de Caraguatatuba</p>
            <p class="text-sm text-muted">2025 · suporte técnico e manutenção de computadores</p>
          </li>
        </ul>
      </div>
      <div class="flex flex-col">
        <h3 class="text-lg font-semibold">Tecnologias com que já trabalhei</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {competencias
            .flatMap((c) => c.itens)
            .map((item) => (
              <li class="chip">{item}</li>
            ))}
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:mt-auto lg:pt-8">
          <a
            href={site.curriculo.href}
            download={site.curriculo.nomeArquivo}
            class="btn btn-primary"
            data-evento="curriculo_download_click"
            data-posicao="home"
          >
            <Icon name="download" size={18} />
            Baixar currículo <span class="text-xs font-normal">({site.curriculo.tamanho})</span>
          </a>
          <a href="/sobre" class="btn btn-secondary">
            Minha trajetória
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactCTA posicao="home" />
</BaseLayout>
