---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon from '@/components/Icon.astro';
import retrato from '@/assets/institucional/diogo-harada-retrato.png';
import { listarDestaques } from '@/lib/projetos';
import { servicos } from '@/data/services';
import { redesVisiveis, site } from '@/data/site';
import { competencias } from '@/data/perfil';

const destaques = await listarDestaques();
if (destaques.length < 3) {
  console.warn(
    `[home] Apenas ${destaques.length} projeto(s) em destaque. RF-04 exige 3 cases reais (ver PENDENCIAS.md).`,
  );
}

const pessoaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.pessoa,
  jobTitle: site.cargo,
  url: Astro.site?.href,
  sameAs: redesVisiveis.map((r) => r.url),
  knowsAbout: competencias.flatMap((c) => c.itens),
};

const ficha = [
  { rotulo: 'Atuação', valor: 'Sites institucionais, lojas virtuais e landing pages' },
  { rotulo: 'Formação', valor: 'Técnico em Informática · CTI-UNESP' },
  { rotulo: 'Cursando', valor: 'Análise e Desenvolvimento de Sistemas · IFSP' },
] as const;
---

<BaseLayout description={site.descricaoPadrao} jsonLd={pessoaJsonLd} type="profile">
  <!-- HERO: proposta + duas jornadas (clientes e recrutadores) -->
  <section class="relative isolate overflow-hidden" aria-labelledby="titulo-hero">
    <div class="fundo-pontos absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="container-site pt-12 sm:pt-20 lg:pt-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-10">
        <div class="lg:col-span-8">
          <p class="rotulo">
            {site.cargo} · {site.marca}
          </p>
          <h1 id="titulo-hero" class="titulo-display mt-6">
            Desenvolvimento web com foco em <em class="destaque-serif">velocidade</em> e
            <em class="destaque-serif">clareza</em>.
          </h1>
          <p class="lead mt-8">
            Sou {site.pessoa}, técnico em Informática pelo CTI-UNESP e estudante de Análise e
            Desenvolvimento de Sistemas no IFSP Caraguatatuba. Crio sites institucionais, lojas
            virtuais e landing pages. Conheça meus projetos ou peça um orçamento.
          </p>
        </div>

        <aside class="lg:col-span-4" aria-label="Resumo profissional">
          <Image
            src={retrato}
            alt="Diogo Harada, de óculos e camisa polo preta, com os braços cruzados sobre um hexágono verde."
            widths={[200, 280, 353]}
            sizes="(min-width: 1024px) 280px, 200px"
            priority
            class="mx-auto h-auto w-[200px] lg:mx-0 lg:ml-auto lg:w-[280px]"
          />
          <dl class="mt-6 border-t border-border">
            {ficha.map((item) => (
              <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-border py-3 text-sm">
                <dt class="meta-mono uppercase">{item.rotulo}</dt>
                <dd class="text-text/90">{item.valor}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>

      <ul
        class="mt-14 grid border-y border-border-strong sm:mt-20 md:grid-cols-2"
        aria-label="Escolha seu caminho"
      >
        <li class="flex flex-col gap-5 py-8 md:py-10 md:pr-10">
          <p class="indice">01 · Para clientes</p>
          <p class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
            Precisa de um site?
          </p>
          <p class="text-muted">Conte sua ideia e receba uma proposta.</p>
          <a
            href="/contato"
            class="btn btn-primary self-start"
            data-evento="cta_orcamento_click"
            data-posicao="hero"
          >
            Pedir orçamento
            <Icon name="seta-direita" size={16} class="icone-seta" />
          </a>
        </li>
        <li class="flex flex-col gap-5 border-t border-border-strong py-8 md:border-t-0 md:border-l md:py-10 md:pl-10">
          <p class="indice">02 · Para recrutadores</p>
          <p class="font-serif text-4xl leading-[1.05] tracking-tight sm:text-5xl">
            Recrutador ou equipe técnica?
          </p>
          <p class="text-muted">Veja cases com código-fonte, stack e trajetória.</p>
          <a href="/projetos" class="btn btn-secondary self-start">
            Ver projetos
            <Icon name="seta-direita" size={16} class="icone-seta" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- PROJETOS EM DESTAQUE -->
  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-projetos">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="rotulo">Portfólio</p>
        <h2 id="titulo-projetos" class="titulo-secao mt-4">
          Projetos <em class="destaque-serif">em destaque</em>
        </h2>
      </div>
      <a href="/projetos" class="link-seta">
        Todos os projetos <Icon name="seta-direita" size={16} class="icone-seta" />
      </a>
    </div>
    <ul class="mt-10 border-b border-border">
      {destaques.map((projeto, i) => (
        <li>
          <ProjectCard projeto={projeto} nivel="h3" indice={i + 1} />
        </li>
      ))}
    </ul>
  </section>

  <!-- SERVIÇOS -->
  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-servicos">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="rotulo">Serviços</p>
        <h2 id="titulo-servicos" class="titulo-secao mt-4">
          O que posso fazer <em class="destaque-serif">pelo seu negócio</em>
        </h2>
      </div>
      <a href="/servicos" class="link-seta">
        Serviços e processo <Icon name="seta-direita" size={16} class="icone-seta" />
      </a>
    </div>
    <ul class="linhas mt-10">
      {servicos.map((servico, i) => (
        <li>
          <ServiceCard servico={servico} nivel="h3" indice={i + 1} />
        </li>
      ))}
    </ul>
  </section>

  <!-- TRAJETÓRIA (jornada do recrutador) -->
  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-trajetoria">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="rotulo">Para recrutadores</p>
        <h2 id="titulo-trajetoria" class="titulo-secao mt-4">
          Formação técnica e <em class="destaque-serif">código aberto</em>
        </h2>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.curriculo.href}
            download={site.curriculo.nomeArquivo}
            class="btn btn-primary"
            data-evento="curriculo_download_click"
            data-posicao="home"
          >
            <Icon name="download" size={18} />
            Baixar currículo <span class="text-xs font-normal">({site.curriculo.tamanho})</span>
          </a>
          <a href="/sobre" class="btn btn-secondary">
            Minha trajetória
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ul class="linhas">
          <li class="grid gap-1 py-6 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <p class="meta-mono pt-1">2022–2024</p>
            <div>
              <p class="font-medium">Técnico em Informática — CTI-UNESP, Bauru/SP</p>
              <p class="mt-1 text-sm text-muted">Concluído · TCC: AtmoVision</p>
            </div>
          </li>
          <li class="grid gap-1 py-6 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <p class="meta-mono pt-1">2025–2027</p>
            <div>
              <p class="font-medium">Análise e Desenvolvimento de Sistemas — IFSP Caraguatatuba</p>
              <p class="mt-1 text-sm text-muted">Em andamento</p>
            </div>
          </li>
          <li class="grid gap-1 py-6 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <p class="meta-mono pt-1">2025</p>
            <div>
              <p class="font-medium">Estágio — Prefeitura de Caraguatatuba</p>
              <p class="mt-1 text-sm text-muted">Suporte técnico e manutenção de computadores</p>
            </div>
          </li>
        </ul>

        <h3 class="meta-mono mt-10 uppercase">Tecnologias com que já trabalhei</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {competencias
            .flatMap((c) => c.itens)
            .map((item) => (
              <li class="chip">{item}</li>
            ))}
        </ul>
      </div>
    </div>
  </section>

  <ContactCTA posicao="home" />
</BaseLayout>
