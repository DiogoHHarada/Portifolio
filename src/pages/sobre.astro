---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import Icon from '@/components/Icon.astro';
import Ilha from '@/components/Ilha.astro';
import foto from '@/assets/institucional/diogo-harada-sobre.png';
import { site } from '@/data/site';
import { competencias, experiencia, formacao, idiomas } from '@/data/perfil';
---

<BaseLayout
  title="Sobre"
  description="Trajetória de Diogo Harada: técnico em Informática pelo CTI-UNESP, estudante de Análise e Desenvolvimento de Sistemas no IFSP Caraguatatuba, competências técnicas e currículo para download."
  type="profile"
>
  <section class="container-site pt-12 sm:pt-20" aria-labelledby="titulo-pagina">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <Image
          src={foto}
          alt="Diogo Harada ao ar livre, de óculos e camisa polo preta, com os braços cruzados."
          widths={[240, 300, 600]}
          sizes="(min-width: 1024px) 300px, 240px"
          priority
          class="mx-auto h-auto w-60 rounded-md border border-border lg:mx-0 lg:w-full lg:max-w-[300px]"
        />
      </div>
      <div class="lg:col-span-8">
        <p class="rotulo">Sobre</p>
        <h1 id="titulo-pagina" class="titulo-pagina mt-6">
          Muito prazer, <em class="destaque-serif">sou {site.pessoa}.</em>
        </h1>
        <div class="mt-8 max-w-[62ch] space-y-5 text-[1.0625rem] text-text/85">
          <p>
            Sou natural de Bauru/SP e comecei na tecnologia em 2022, no Colégio Técnico Industrial
            (CTI-UNESP), onde me formei técnico em Informática. Lá construí a base em programação
            com PHP, C#, Java e Python, desenvolvimento web com HTML e CSS e bancos de dados MySQL e
            PostgreSQL.
          </p>
          <p>
            Durante o curso, trabalhei em projetos colaborativos com a metodologia Scrum. Entre eles
            estão uma loja virtual completa e o AtmoVision, meu trabalho de conclusão de curso: uma
            plataforma de monitoramento meteorológico com IoT e Grafana para a comunidade do CTI.
          </p>
          <p>
            Hoje curso Análise e Desenvolvimento de Sistemas no IFSP Caraguatatuba, onde busco
            aplicar a tecnologia a causas reais. Um exemplo foi minha participação em uma GameJam,
            em que criei um jogo colaborativo no GameMaker voltado à conscientização ambiental da
            cidade — um desafio que uniu criatividade, código e a vontade de gerar impacto positivo
            na região.
          </p>
        </div>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <Ilha
            nome="ima"
            class="[&_.btn]:w-full sm:[&_.btn]:w-auto"
            props={{ padding: 60, magnetStrength: 4, wrapperClassName: 'w-full sm:w-auto' }}
          >
            <a
              href={site.curriculo.href}
              download={site.curriculo.nomeArquivo}
              class="btn btn-primary"
              data-evento="curriculo_download_click"
              data-posicao="sobre"
            >
              <Icon name="download" size={18} />
              Baixar currículo <span class="text-xs font-normal">({site.curriculo.tamanho})</span>
            </a>
          </Ilha>
          <SocialLinks />
        </div>
      </div>
    </div>
  </section>

  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-formacao">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="rotulo">Percurso</p>
        <h2 id="titulo-formacao" class="titulo-secao mt-4">
          Formação
        </h2>
        <ol class="linhas mt-8">
          {formacao.map((f) => (
            <li class="py-6">
              <h3 class="font-medium">{f.curso}</h3>
              <p class="mt-1 text-muted">{f.instituicao}</p>
              <p class="meta-mono mt-3">
                {f.periodo} · <span class="text-accent">{f.status}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <p class="rotulo">Prática</p>
        <h2 class="titulo-secao mt-4">Experiência</h2>
        <ol class="linhas mt-8">
          {experiencia.map((e) => (
            <li class="py-6">
              <h3 class="font-medium">
                {e.cargo} — {e.organizacao}
              </h3>
              <p class="meta-mono mt-2">{e.periodo}</p>
              <ul class="mt-4 list-[square] space-y-1.5 pl-5 text-[0.95rem] text-muted marker:text-accent">
                {e.atividades.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-competencias">
    <p class="rotulo">Ferramentas</p>
    <h2 id="titulo-competencias" class="titulo-secao mt-4">
      Competências
    </h2>
    <dl class="linhas mt-8">
      {competencias.map((c) => (
        <div class="grid gap-3 border-t border-border py-6 last:border-b sm:grid-cols-[13rem_1fr] sm:gap-8">
          <dt class="meta-mono pt-1 uppercase">{c.grupo}</dt>
          <dd>
            <ul class="flex flex-wrap gap-2">
              {c.itens.map((item) => (
                <li class="chip text-text/90">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
    <p class="meta-mono mt-6">
      Idiomas: {idiomas.map((i) => `${i.idioma} — ${i.nivel}`).join(' · ')}
    </p>
  </section>

  <ContactCTA
    posicao="sobre"
    titulo="Vamos trabalhar juntos?"
    texto="Se você tem uma vaga, um projeto ou quer trocar uma ideia, me chame no WhatsApp ou veja os outros canais de contato."
  />
</BaseLayout>
