---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { processo, servicos } from '@/data/services';
---

<BaseLayout
  title="Serviços"
  description="Criação de sites institucionais, lojas virtuais e landing pages responsivas por Diogo Harada. Veja o que cada serviço inclui, como funciona o processo e peça um orçamento."
>
  <section class="container-site pt-12 sm:pt-20" aria-labelledby="titulo-pagina">
    <p class="rotulo">Serviços</p>
    <h1 id="titulo-pagina" class="titulo-pagina mt-6">
      Sites para pequenos negócios <em class="destaque-serif">e profissionais</em>
    </h1>
    <p class="lead mt-6">
      Desenvolvo sites que carregam rápido, funcionam bem no celular e deixam claro como o cliente
      chega até você. O escopo de cada projeto é definido junto com você antes de começar.
    </p>

    <ul class="linhas mt-14">
      {servicos.map((servico, i) => (
        <li>
          <ServiceCard servico={servico} nivel="h2" indice={i + 1} detalhado />
        </li>
      ))}
    </ul>
  </section>

  <section class="container-site mt-28 sm:mt-36" aria-labelledby="titulo-processo">
    <p class="rotulo">Como funciona</p>
    <h2 id="titulo-processo" class="titulo-secao mt-4">
      Do primeiro contato <em class="destaque-serif">à entrega</em>
    </h2>
    <ol class="mt-12 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
      {processo.map((etapa, i) => (
        <li class="border-t border-border-strong pt-5 pb-10">
          <span class="indice" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 font-serif text-3xl leading-tight tracking-tight">
            <span class="sr-only">Etapa {i + 1}: </span>
            {etapa.titulo}
          </h3>
          <p class="mt-3 text-[0.95rem] text-muted">{etapa.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <ContactCTA
    posicao="servicos"
    titulo="Vamos conversar sobre o seu projeto?"
    texto="Envie uma mensagem pelo WhatsApp contando o tipo de site que você precisa. Com essas informações, preparo uma proposta com escopo e prazo."
  />
</BaseLayout>
