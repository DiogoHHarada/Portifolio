---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout
  title="Página não encontrada"
  description="O endereço acessado não existe no site de Diogo Harada. Volte ao início ou veja os projetos."
  noindex
>
  <section class="container-site py-20 sm:py-28" aria-labelledby="titulo-pagina">
    <p class="rotulo">Erro 404</p>
    <p
      class="mt-6 font-serif text-[clamp(6rem,3rem+18vw,14rem)] leading-[0.85] tracking-tight text-accent"
      aria-hidden="true"
    >
      404
    </p>
    <h1 id="titulo-pagina" class="titulo-secao mt-6">
      Página não encontrada
    </h1>
    <p class="lead mt-4">
      O endereço pode ter mudado ou foi digitado incorretamente. Use um dos caminhos abaixo para
      continuar navegando.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">
        <Icon name="seta-esquerda" size={18} /> Voltar ao início
      </a>
      <a href="/projetos" class="btn btn-secondary">
        Ver projetos
        <Icon name="seta-direita" size={16} class="icone-seta" />
      </a>
    </div>
  </section>
</BaseLayout>
