# Copie para .env apenas se precisar sobrescrever valores localmente.
# NUNCA versione valores reais de credenciais.

# URL pública canônica do site (canonical, Open Graph, sitemap).
# Padrão no código: https://harada-dev-systems.vercel.app
# Defina na Vercel quando houver domínio próprio registrado.
SITE_URL=

# --- Fase 5 (OPCIONAL, NÃO AUTORIZADA) -------------------------------------
# Somente servidor. Não usar prefixo PUBLIC_. Preencher apenas no painel da Vercel
# se a fase 5 for aprovada explicitamente.
# RESEND_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET=
