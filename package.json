{
  "name": "harada-devsystems",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio profissional e vitrine de serviços de Diogo Harada (Harada DevSystems).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate": "npm run lint && npm run format:check && npm run check && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "@fontsource/poppins": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "astro": "7.4.12",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.8"
    }
  }
}
